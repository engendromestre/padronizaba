generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id          String      @id @default(cuid())
  nome        String
  estado      String
  ativo       Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  clientes    Cliente[]
  consultores Consultor[]
  consultas   Consulta[]

  @@map("empresas")
}

model Cliente {
  id           String          @id @default(cuid())
  empresaId    String
  nomeProdutor String
  nomeFazenda  String
  frigorifico  String
  cidade       String
  ativo        Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  empresa      Empresa         @relation(fields: [empresaId], references: [id])
  grupos       GrupoWhatsapp[]
  consultas    Consulta[]

  @@map("clientes")
}

model GrupoWhatsapp {
  id              String   @id @default(cuid())
  clienteId       String
  groupIdWhatsapp String   @unique
  nomeGrupo       String
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  cliente         Cliente  @relation(fields: [clienteId], references: [id])

  @@map("grupos_whatsapp")
}

model Consultor {
  id        String         @id @default(cuid())
  empresaId String
  nome      String
  email     String         @unique
  senhaHash String
  ativo     Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  empresa   Empresa        @relation(fields: [empresaId], references: [id])
  consultas Consulta[]
  logs      AuditoriaLog[]

  @@map("consultores")
}

model Consulta {
  id               String              @id @default(cuid())
  empresaId        String
  clienteId        String
  consultorId      String
  dataAbate        DateTime
  frigorifico      String
  cidade           String
  qtdMachos        Int                 @default(0)
  qtdFemeas        Int                 @default(0)
  pesoVivoKg       Float
  pesoCarcacaKg    Float
  mediaArroba      Float
  rcPercentual     Float
  maturidadeJson   Json
  acabamentoJson   Json
  penalizacoes     String?
  dif              String?
  escoreRuminal    String?
  perdaVacinalKg   Float?
  bezerrosJson     Json?
  contaminacaoGiKg Float?
  hematomasKg      Float?
  deslocamento     Boolean             @default(false)
  relatorioAbate   Boolean             @default(false)
  dataFaturamento  DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  empresa          Empresa             @relation(fields: [empresaId], references: [id])
  cliente          Cliente             @relation(fields: [clienteId], references: [id])
  consultor        Consultor           @relation(fields: [consultorId], references: [id])
  financeiro       ConsultaFinanceiro?
  logs             AuditoriaLog[]

  @@map("consultas")
}

model ConsultaFinanceiro {
  id            String   @id @default(cuid())
  consultaId    String   @unique
  valorUnitario Float
  totalBruto    Float
  nota          Float?
  totalLiquido  Float?
  ticketMedio   Float?
  meses         Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  consulta      Consulta @relation(fields: [consultaId], references: [id])

  @@map("consulta_financeiro")
}

model AuditoriaLog {
  id            String     @id @default(cuid())
  empresaId     String?
  consultorId   String?
  consultaId    String?
  tabelaAfetada String
  registroId    String
  acao          String
  dadosAntes    Json?
  dadosDepois   Json?
  ipOrigem      String?
  createdAt     DateTime   @default(now())
  consultor     Consultor? @relation(fields: [consultorId], references: [id])
  consulta      Consulta?  @relation(fields: [consultaId], references: [id])

  @@map("auditoria_logs")
}